{
  "name": "compass",
  "description": "一套专门for极客时间《企业级Agent工程架构实战营》定制的电商DataAgent脚手架和示例系统",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "uv sync --locked --all-packages && pnpm contracts",
    "dev": "node scripts/tasks.mjs dev",
    "build": "node scripts/tasks.mjs build",
    "deploy": "node scripts/deploy.mjs up",
    "deploy:status": "node scripts/deploy.mjs status",
    "deploy:logs": "node scripts/deploy.mjs logs",
    "deploy:down": "node scripts/deploy.mjs down",
    "lint": "node scripts/tasks.mjs lint",
    "lint:tooling": "uv run --locked ruff check scripts",
    "format": "pnpm format:frontend && pnpm format:python",
    "format:frontend": "prettier --write .",
    "format:python": "uv run --locked ruff format .",
    "format:check": "prettier --check . && uv run --locked ruff format --check .",
    "typecheck": "node scripts/tasks.mjs typecheck",
    "test": "node scripts/tasks.mjs test",
    "test:tooling": "node --test scripts/*.test.mjs",
    "check": "pnpm test:tooling && pnpm format:check && pnpm lint:tooling && pnpm contracts:check && uv run --locked python scripts/check-workspace.py && node scripts/tasks.mjs lint typecheck test",
    "contracts": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "doctor": "node scripts/doctor.mjs",
    "db:up": "docker compose -f deploy/compose/compose.yaml up -d --wait postgres",
    "db:down": "docker compose -f deploy/compose/compose.yaml down",
    "db:migrate": "node scripts/tasks.mjs db:migrate",
    "db:seed": "node scripts/tasks.mjs seed",
    "smoke": "node scripts/smoke.mjs",
    "dev:home": "pnpm dev --filter=home",
    "build:home": "pnpm build --filter=home",
    "data:seed": "node scripts/data-seed.mjs",
    "data:prepare": "node scripts/prepare-data.mjs",
    "db:provision": "node scripts/tasks.mjs db:provision",
    "db:sql": "node scripts/tasks.mjs db:sql",
    "db:sql:check": "node scripts/tasks.mjs db:sql:check",
    "db:apply-sql": "node scripts/tasks.mjs db:apply-sql",
    "db:manage": "node scripts/tasks.mjs db:manage",
    "test:integration": "node scripts/tasks.mjs test:integration",
    "test:e2e": "node scripts/tasks.mjs test:e2e",
    "test:setup": "node scripts/tasks.mjs test:setup"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.7"
  }
}
