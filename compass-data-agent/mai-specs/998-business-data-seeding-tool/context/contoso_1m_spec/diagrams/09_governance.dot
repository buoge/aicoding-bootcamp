digraph ER {
graph [rankdir=TB, bgcolor="white", nodesep=0.28, ranksep=0.62, pad=0.28, splines=polyline, concentrate=false, fontname="DejaVu Sans"];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#688099", penwidth=1.1, arrowsize=0.55, fontsize=9, fontname="DejaVu Sans"];
"core.tenant" [label=<<TABLE BORDER="1" COLOR="#c4d2df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173c56"><FONT COLOR="white"><B>core.tenant</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  tenant_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#435c72">FK  release_id</FONT></TD></TR></TABLE>>];
"ops.dataset_release" [label=<<TABLE BORDER="1" COLOR="#c4d2df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173c56"><FONT COLOR="white"><B>ops.dataset_release</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  release_id</FONT></TD></TR></TABLE>>];
"ops.ingestion_batch" [label=<<TABLE BORDER="1" COLOR="#c4d2df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173c56"><FONT COLOR="white"><B>ops.ingestion_batch</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  tenant_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  batch_id</FONT></TD></TR></TABLE>>];
"ops.generation_run" [label=<<TABLE BORDER="1" COLOR="#c4d2df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173c56"><FONT COLOR="white"><B>ops.generation_run</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  run_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#435c72">FK  release_id</FONT></TD></TR></TABLE>>];
"ops.file_manifest" [label=<<TABLE BORDER="1" COLOR="#c4d2df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173c56"><FONT COLOR="white"><B>ops.file_manifest</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  file_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#435c72">FK  release_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#435c72">FK  run_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#435c72">FK  tenant_id ?</FONT></TD></TR></TABLE>>];
"ops.source_watermark" [label=<<TABLE BORDER="1" COLOR="#c4d2df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173c56"><FONT COLOR="white"><B>ops.source_watermark</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  tenant_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  source_system</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  observed_at</FONT></TD></TR></TABLE>>];
"eval.scenario" [label=<<TABLE BORDER="1" COLOR="#c4d2df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173c56"><FONT COLOR="white"><B>eval.scenario</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  scenario_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#435c72">FK  tenant_id</FONT></TD></TR></TABLE>>];
"eval.question" [label=<<TABLE BORDER="1" COLOR="#c4d2df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173c56"><FONT COLOR="white"><B>eval.question</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  question_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#435c72">FK  scenario_id ?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#435c72">FK  tenant_id</FONT></TD></TR></TABLE>>];
"eval.expected_result" [label=<<TABLE BORDER="1" COLOR="#c4d2df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173c56"><FONT COLOR="white"><B>eval.expected_result</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  question_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  release_id</FONT></TD></TR></TABLE>>];
"ops.dataset_release" -> "core.tenant" [taillabel="1", headlabel="0..N", labeldistance=1.5];
"core.tenant" -> "ops.ingestion_batch" [taillabel="1", headlabel="0..N", labeldistance=1.5];
"ops.dataset_release" -> "ops.generation_run" [taillabel="1", headlabel="0..N", labeldistance=1.5];
"ops.dataset_release" -> "ops.file_manifest" [taillabel="1", headlabel="0..N", labeldistance=1.5];
"ops.generation_run" -> "ops.file_manifest" [taillabel="1", headlabel="0..N", labeldistance=1.5];
"core.tenant" -> "ops.file_manifest" [taillabel="0..1", headlabel="0..N", labeldistance=1.5];
"core.tenant" -> "ops.source_watermark" [taillabel="1", headlabel="0..N", labeldistance=1.5];
"core.tenant" -> "eval.scenario" [taillabel="1", headlabel="0..N", labeldistance=1.5];
"eval.scenario" -> "eval.question" [taillabel="0..1", headlabel="0..N", labeldistance=1.5];
"core.tenant" -> "eval.question" [taillabel="1", headlabel="0..N", labeldistance=1.5];
"eval.question" -> "eval.expected_result" [taillabel="1", headlabel="0..N", labeldistance=1.5];
"ops.dataset_release" -> "eval.expected_result" [taillabel="1", headlabel="0..N", labeldistance=1.5];
}