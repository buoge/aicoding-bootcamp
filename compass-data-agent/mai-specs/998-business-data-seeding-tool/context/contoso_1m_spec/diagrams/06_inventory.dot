"core.inventory_document" [label=<<TABLE BORDER="1" COLOR="#c4d2df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173c56"><FONT COLOR="white"><B>core.inventory_document</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  tenant_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  inventory_doc_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#435c72">FK  from_site_id ?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#435c72">FK  to_site_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#435c72">FK  region_id</FONT></TD></TR></TABLE>>];
