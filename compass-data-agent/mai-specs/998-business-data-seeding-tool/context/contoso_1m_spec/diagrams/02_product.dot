"core.channel_listing" [label=<<TABLE BORDER="1" COLOR="#c4d2df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173c56"><FONT COLOR="white"><B>core.channel_listing</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  tenant_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  listing_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#435c72">FK  channel_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#435c72">FK  sku_id</FONT></TD></TR></TABLE>>];
