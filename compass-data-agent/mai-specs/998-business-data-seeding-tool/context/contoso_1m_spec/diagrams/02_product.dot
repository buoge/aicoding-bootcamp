digraph ER {
graph [rankdir=TB, bgcolor="white", nodesep=0.28, ranksep=0.62, pad=0.28, splines=polyline, concentrate=false, fontname="DejaVu Sans"];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#688099", penwidth=1.1, arrowsize=0.55, fontsize=9, fontname="DejaVu Sans"];
"core.brand" [label=<<TABLE BORDER="1" COLOR="#c4d2df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173c56"><FONT COLOR="white"><B>core.brand</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  tenant_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  brand_id</FONT></TD></TR></TABLE>>];
