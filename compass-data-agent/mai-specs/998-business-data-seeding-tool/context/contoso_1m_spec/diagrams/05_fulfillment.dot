"core.stock_allocation_attempt" [label=<<TABLE BORDER="1" COLOR="#c4d2df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173c56"><FONT COLOR="white"><B>core.stock_allocation_attempt</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  tenant_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#164a69">PK  allocation_attempt_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#435c72">FK  order_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#435c72">FK  region_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#435c72">FK  site_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#435c72">FK  sku_id</FONT></TD></TR></TABLE>>];
"core.site" -> "core.shipment" [taillabel="1", headlabel="0..N", labeldistance=1.5];
"core.shipment" -> "core.shipment_item" [taillabel="1", headlabel="0..N", labeldistance=1.5];
"core.order_unit" -> "core.shipment_item" [taillabel="1", headlabel="0..N", labeldistance=1.5];
