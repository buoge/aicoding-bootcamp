{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["PYTHON_TOOLCHAIN_ID"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/mai-specs/998-business-data-seeding-tool/design/business-schema.sql"
      ]
    },
    "lint": {
      "env": ["PYTHON_TOOLCHAIN_ID"]
    },
    "typecheck": {
      "env": ["PYTHON_TOOLCHAIN_ID"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/mai-specs/998-business-data-seeding-tool/design/business-schema.sql"
      ]
    },
    "test": {
      "env": ["PYTHON_TOOLCHAIN_ID"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/mai-specs/998-business-data-seeding-tool/design/business-schema.sql"
      ]
    },
    "test:integration": {
      "cache": false,
      "passThroughEnv": ["COMPASS_RETAIL_TEST_ADMIN_URL"]
    }
  }
}
