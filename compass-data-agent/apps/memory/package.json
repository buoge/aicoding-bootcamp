{
  "name": "@compass/memory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "uv run --locked --package compass-memory uvicorn compass_memory.main:app --host 127.0.0.1 --port 8001 --reload",
    "build": "uv build --package compass-memory --out-dir dist",
    "lint": "uv run --locked ruff check . && uv run --locked ruff format --check .",
    "typecheck": "uv run --locked pyright --project ../../pyproject.toml src tests",
    "test": "uv run --locked pytest tests"
  }
}
