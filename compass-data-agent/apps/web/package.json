{
  "name": "@compass/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:provision": "node scripts/db-provision.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:sql": "node scripts/db-sql.mjs",
    "db:sql:check": "node scripts/db-sql.mjs --check",
    "db:apply-sql": "node scripts/db-migrate.mjs --mode sql",
    "db:manage": "node scripts/db-manage.mjs",
    "seed": "node scripts/db-seed.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:setup": "node scripts/test-setup.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "lucide-react": "1.59.0",
    "next": "16.4.6",
    "node-pg-migrate": "9.0.0",
    "openapi-fetch": "0.17.0",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
